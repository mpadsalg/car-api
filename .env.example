CARAPI_APP_NAME=car-api
# Default is in-memory SQLite (data lost on restart)
CARAPI_DATABASE_URL=sqlite+pysqlite:///:memory:
CARAPI_SQL_ECHO=false
CARAPI_LOG_LEVEL=INFO

# Comma-separated; required for POST/PATCH/DELETE. Empty => writes always 401.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
CARAPI_API_KEYS=

CARAPI_RATE_LIMIT_ENABLED=true
CARAPI_RATE_LIMIT_REQUESTS=60
CARAPI_RATE_LIMIT_WINDOW_SECONDS=60

# Loaded on startup (atomic; invalid file => startup fails). Comment out to start empty.
CARAPI_SEED_FILE=seed/cars.csv
CARAPI_IMPORT_MAX_BYTES=5000000
CARAPI_IMPORT_MAX_ROWS=10000
